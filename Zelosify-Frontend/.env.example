# Copy to .env. Backend API base URL.
NEXT_PUBLIC_BACKEND_URL=http://localhost:5001/api/v1

# Google / Microsoft sign-in buttons. They need OAuth apps configured in
# Keycloak (identity providers) and backend routes; hidden unless "true".
NEXT_PUBLIC_ENABLE_SSO=false

# Optional: Keycloak realm RS256 public key for the route guard's token check.
# If unset, it is fetched from the backend (GET /auth/public-key) and cached.
# KEYCLOAK_RS256_SIG=
