# Copy to .env and fill in. Never commit .env.

# --- Database (docker compose: recruit-postgres) -----------------------------
DATABASE_URL=postgresql://postgres:<password>@localhost:5445/zelosify_recruit_test?schema=app

# --- Server --------------------------------------------------------------------
PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
# 64 hex chars each: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=<random-64-hex>
JWT_SECRET=<random-64-hex>
ENCRYPTION_ALGORITHM=aes-256-gcm
ENCRYPTION_KEY=<random-64-hex>

# --- Storage (AWS S3) ----------------------------------------------------------
STORAGE_PROVIDER=aws
S3_AWS_REGION=us-east-1
S3_BUCKET_NAME=<bucket>
S3_ACCESS_KEY_ID=<access-key-id>
S3_SECRET_ACCESS_KEY=<secret-access-key>

# --- Keycloak --------------------------------------------------------------------
KEYCLOAK_URL=http://localhost:8080/auth
KEYCLOAK_REALM=Zelosify
KEYCLOAK_CLIENT_ID=<client-id>
KEYCLOAK_CLIENT_SECRET=<client-secret>
KEYCLOAK_ADMIN=<admin-user>
KEYCLOAK_ADMIN_PASSWORD=<admin-password>
# Realm public key (Realm settings → Keys → RS256 → Public key)
KEYCLOAK_RS256_SIG=<public-key>

# --- Registration policy (security fix A1) -----------------------------------
# Roles anyone may self-register with (comma list). Default: none.
SELF_REGISTRATION_ROLES=
# Admin-issued key required (header X-Registration-Key) for every other role.
# If unset: development allows all roles (setup guide works), production refuses.
REGISTRATION_ADMIN_KEY=

# --- AI recommendation agent -------------------------------------------------
# gemini (default) | groq
LLM_PROVIDER=gemini
GEMINI_API_KEY=<gemini-api-key>
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=8000
# Optional alternative provider
GROQ_API_KEY=
# Comma-separated fallback chain (each model has its own free-tier budget)
GROQ_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-120b,openai/gpt-oss-20b
GROQ_TIMEOUT_MS=6000
# Parallel recommendation jobs (bounded to respect LLM rate limits)
RECOMMENDATION_CONCURRENCY=2
